{
  "realm": "hirenow",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "passwordPolicy": "length(8) and upperCase(1) and lowerCase(1) and digits(1) and notUsername",
  "bruteForceProtected": true,
  "roles": {
    "realm": [{ "name": "Seller" }, { "name": "Buyer" }, { "name": "Admin" }]
  },
  "clients": [
    {
      "clientId": "hirenow-api",
      "name": "HireNow API",
      "publicClient": false,
      "secret": "${KEYCLOAK_API_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "hirenow-frontend",
      "name": "HireNow frontend",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "hirenow-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "hirenow-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-hirenow-api",
      "enabled": true,
      "serviceAccountClientId": "hirenow-api",
      "clientRoles": { "realm-management": ["manage-users", "view-realm"] }
    },
    {
      "id": "5e11e400-0000-4000-8000-000000000001",
      "username": "seller",
      "email": "seller@hirenow.test",
      "firstName": "Sam",
      "lastName": "Seller",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["Seller"],
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_DEV_USER_PASSWORD}" }]
    },
    {
      "id": "b0b0b0b0-0000-4000-8000-000000000002",
      "username": "buyer",
      "email": "buyer@hirenow.test",
      "firstName": "Bo",
      "lastName": "Buyer",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["Buyer"],
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_DEV_USER_PASSWORD}" }]
    },
    {
      "id": "ad000000-0000-4000-8000-000000000003",
      "username": "admin",
      "email": "admin@hirenow.test",
      "firstName": "Ada",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["Admin"],
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_DEV_USER_PASSWORD}" }]
    }
  ]
}
