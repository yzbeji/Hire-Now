# Local development only. Copy to .env, which git ignores.
# SQL Server requires 8+ characters with upper case, lower case and a digit or symbol.
# Avoid ; and $ because the value is placed in a connection string by Docker Compose.
MSSQL_SA_PASSWORD=HireNow_Local1!

# Keycloak admin console user "admin", at http://localhost:8081
KEYCLOAK_ADMIN_PASSWORD=HireNow_Admin1!
# Password of the local test users: seller, buyer and admin.
KEYCLOAK_DEV_USER_PASSWORD=HireNow_User1!
